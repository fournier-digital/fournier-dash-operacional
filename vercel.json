{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "src/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)", "headers": { "X-Content-Type-Options": "nosniff" }, "continue": true },
    { "src": "/api/(.*)", "dest": "/api/index.py?__route=$1" },
    { "src": "/src/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } }
  ]
}
